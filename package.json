{
  "name": "lucky-transport",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "start": "npm start --workspace server",
    "seed": "npm run seed --workspace server",
    "test": "npm test --workspace server",
    "test:integration": "npm run test:integration --workspace server",
    "format": "prettier --write \"client/src/**/*.{js,jsx,css}\" \"server/**/*.js\" \"*.{json,md,yaml}\" \"docs/*.md\""
  },
  "workspaces": [
    "server",
    "client"
  ],
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.9.9"
  }
}
