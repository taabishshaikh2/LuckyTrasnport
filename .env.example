# Copy to server/.env. Never commit the populated file.
MONGODB_URI=mongodb://127.0.0.1:27017/luckyTransport?replicaSet=rs0
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h
PORT=3001
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
COMPANY_NAME=Lucky Transport Services
COMPANY_ADDRESS=
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_GSTIN=
COMPANY_PAN=
COMPANY_STATE_CODE=27
COMPANY_BANK_NAME=
COMPANY_BANK_ACCOUNT=
COMPANY_BANK_IFSC=
COMPANY_TAGLINE=Transport services, Mumbai
COMPANY_DISPUTE_CLAUSE=
COMPANY_INTEREST_CLAUSE=
COMPANY_PAYMENT_CLAUSE=
# Seed only with explicit opt-in, on development databases.
ALLOW_DEV_SEED=false
